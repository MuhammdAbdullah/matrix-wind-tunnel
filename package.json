{
    "name": "matrix-wind-tunnel",
    "version": "0.1.0",
    "description": "Matrix Wind Tunnel Control and Calibrator",
    "main": "main.js",
    "private": true,
    "scripts": {
        "start": "electron .",
        "dev": "electron . --dev",
        "build-win": "electron-builder --win"
    },
    "devDependencies": {
        "electron": "^43.1.0",
        "electron-builder": "^26.15.3"
    },
    "dependencies": {
        "electron-updater": "^6.6.2",
        "serialport": "^12.0.0"
    },
    "build": {
        "appId": "com.matrix.windtunnel",
        "productName": "Wind Tunnel",
        "directories": { "output": "dist" },
        "files": ["main.js", "preload.js", "renderer/**/*", "assets/**/*", "package.json"],
        "win": { "target": "nsis", "artifactName": "Wind-Tunnel-Setup-${version}.${ext}" }
    }
}
